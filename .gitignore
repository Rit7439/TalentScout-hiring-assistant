*.pyc
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/

# Virtual environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data (contains PII - do not commit)
data/candidates.json
data/conversations.json

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml
